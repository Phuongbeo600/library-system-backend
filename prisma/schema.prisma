generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"

}

model Book {
    id        Int      @id @default(autoincrement())
    title     String
    author    String
    quantity  Int      @default(0)
    createdAt DateTime @default(now())

     borrowings Borrowing[]
}

model Employee {
    id        Int      @id @default(autoincrement())
    name      String
    email     String
    role      Role
    createdAt DateTime @default(now())
}

enum Role {
    GUEST
    LIBRARIAN
    ADMIN
}

model Borrowing {
  id           Int       @id @default(autoincrement())
  borrowerName String    
  bookId       Int       
  borrowedAt   DateTime  @default(now()) 
  returnedAt   DateTime? 

  // Tạo liên kết với bảng Book (Để biết mượn cuốn sách nào)
  book         Book      @relation(fields: [bookId], references: [id])
}